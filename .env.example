# Placeholder values only — never commit real secrets.
# Copy to .env (gitignored) for local apps when they exist.

# --- Brand (packages/contracts resolveBrand; flip for G1 fallback) ---
# primary | fallback — selects name/domain/tagline/disclaimer as a set
BRAND=primary
# Optional overrides (default to the selected brand's fields):
BRAND_NAME=Mamdani, Fix This
BRAND_DOMAIN=mamdanifixthis.example
BRAND_TAGLINE=Tag Mamdani. Put it on the map.
# BRAND=fallback
# BRAND_NAME=NYC Public Fix Map
# BRAND_DOMAIN=nycpublicfixmap.example
# BRAND_TAGLINE=See what needs fixing. Put it on the map.

# --- Database ---
# Local Docker Compose (npm run db:local): PostGIS on 5432, or 5433 if 5432 is taken.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mamdani
# Local Supabase CLI default (alternative):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase (hosted / CLI auth; optional for local Docker + ALLOW_DEV_AUTH) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare / R2 (production placeholders; local API uses filesystem/mock) ---
CLOUDFLARE_ACCOUNT_ID=your-account-id
R2_BUCKET_PRIVATE=mamdani-ticketer-private
R2_BUCKET_PUBLIC=mamdani-ticketer-public
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# --- API (apps/api) ---
API_PORT=8787
CORS_ORIGINS=http://localhost:5173
# Local only: accept x-dev-user-id (never enable in production)
ALLOW_DEV_AUTH=false
# filesystem | mock — production should use R2 via env above (not required for local)
OBJECT_STORE=filesystem
UPLOAD_DIR=.uploads
# Base URL used in signed upload/download URLs for local/dev object store
PUBLIC_UPLOAD_BASE_URL=http://localhost:8787/dev-uploads
# Review capacity for intake cap (SPEC §12): pending_review > 2× capacity → 1/day
DAILY_REVIEW_CAPACITY=30
# Soft NYC bbox check (optional); submissions still require moderator review
NYC_LNG_MIN=-74.3
NYC_LNG_MAX=-73.7
NYC_LAT_MIN=40.4
NYC_LAT_MAX=40.95

# --- Public site ---
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787

# --- Web app (apps/web) — Vite reads VITE_* from apps/web/.env (or root if loaded) ---
# Copy the VITE_* lines into apps/web/.env for the Vite dev server.
VITE_API_URL=http://localhost:8787
# primary | fallback — must match API BRAND for a consistent flip
VITE_BRAND=primary
# Optional Protomaps style URL (R2/CDN). When unset, web uses local
# /basemap/nyc.pmtiles if present (bash apps/web/scripts/fetch-nyc-pmtiles.sh),
# else OpenFreeMap as an explicit local-dev fallback — not public OSM tiles.
VITE_MAP_STYLE_URL=
VITE_MAP_TILE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Dev-only: allow in-memory user id + x-dev-user-id header when Supabase is unset
# Seeded local admin: 00000000-0000-4000-8000-000000000001 (npm run db:seed)
VITE_ALLOW_DEV_AUTH=false

# --- Milestone 2 analysis / media worker ---
# Master switch (also stored in analysis_settings; env seeds API defaults)
ANALYSIS_ENABLED=true
# Conservative estimate reserved before a paid transcription call (cents)
ANALYSIS_ESTIMATE_CENTS=5
# Daily / monthly caps live in DB analysis_settings (defaults $5/day, $100/month)
# Worker:
# TRANSCRIPTION_PROVIDER=mock|openai
# OPENAI_API_KEY=  # required for TRANSCRIPTION_PROVIDER=openai — never commit
# GEOCODER_PROVIDER=nyc_geosearch|local_stub
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# WORKER_ONCE=false
# WORKER_CONCURRENCY=2
# WORKER_LEASE_SECONDS=120

# --- Milestone 3 launch (snapshots, share cards, legal, monitoring, export) ---
# Artifacts (share cards + snapshot JSON). Local filesystem; production → R2.
ARTIFACT_DIR=.artifacts
# Optional Cloudflare CDN purge (leave placeholder to use local purge log only)
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Error monitoring — local structured logs always on; set a real DSN to enable remote hook
SENTRY_DSN=
# Encrypted DB export: openssl rand -base64 32
EXPORT_ENCRYPTION_KEY=
EXPORT_DIR=.exports
# Ops outbox drain without ALLOW_DEV_AUTH (local cron / staging)
ALLOW_OPS_OUTBOX=false

# Legal / operator fields (Terms & Privacy stay DRAFT; readiness fails if unset)
LEGAL_POLICY_VERSION=0.1.0-draft
LEGAL_EFFECTIVE_DATE=
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_SUPPORT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_APPEAL_EMAIL=
LEGAL_HOSTING_PROVIDERS=Local Postgres + filesystem object store (dev); production TBD
LEGAL_ANALYSIS_PROVIDERS=Mock transcription/geocoder in local; production providers TBD
LEGAL_ANALYTICS_DESCRIPTION=None — essential session/security storage and interface preferences only.
LEGAL_DNT_RESPONSE=Honored where feasible; no advertising trackers in the launch design.

# Copyright agent — /copyright stays hidden in nav until ALL four are set
COPYRIGHT_AGENT_NAME=
COPYRIGHT_AGENT_ADDRESS=
COPYRIGHT_AGENT_PHONE=
COPYRIGHT_AGENT_EMAIL=
